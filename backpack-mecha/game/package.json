{
  "name": "backpack-mecha",
  "version": "0.2.0-dev.13",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "art:check": "python3 scripts/art-check.py",
    "art:optimize": "python3 scripts/optimize-art.py",
    "bundle:check": "node scripts/check-bundle.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "probe": "node --experimental-strip-types scripts/balance-probe.ts",
    "probe:natural": "node --experimental-strip-types scripts/natural-probe.ts",
    "compare:growth": "node --experimental-strip-types scripts/growth-comparison.ts",
    "qa:motion": "node --experimental-strip-types scripts/motion-fixtures.ts",
    "qa:motion:serve": "node scripts/serve-motion.mjs",
    "compare:motion": "node scripts/compare-motion.mjs",
    "probe:expeditions": "node --experimental-strip-types scripts/expedition-probe.ts"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
